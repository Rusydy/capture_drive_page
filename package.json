{
  "name": "capture-drive-page",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "capture": "node --env-file=.env --experimental-strip-types src/capture-drive-page.ts",
